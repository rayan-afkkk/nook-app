rules_version = '2';

// Nook Firestore rules. Field names must stay in sync with app/.../data/firebase/Mappers.kt.
// Principles: only chat members read/write a chat; usernames are permanent and can't be stolen;
// people can only edit their own profile. NOTE: data is not end-to-end encrypted.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isUser(userId) { return signedIn() && uid() == userId; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanged(keys) { return changed().hasOnly(keys); }
    function chatDoc(chatId) { return get(/databases/$(database)/documents/chats/$(chatId)); }
    function isMember(chatId) { return signedIn() && uid() in chatDoc(chatId).data.members; }
    function validUsername(name) {
      return name is string && name.matches('^[a-z0-9_.]{3,20}$')
        && !name.matches('^[.].*') && !name.matches('.*[.]$') && !name.matches('.*[.][.].*');
    }
    function shortString(v, max) { return v is string && v.size() <= max; }

    // ---------- Users ----------
    match /users/{userId} {
      allow read: if signedIn();
      // Creating a profile must claim the matching username in the same transaction.
      allow create: if isUser(userId)
        && request.resource.data.uid == userId
        && validUsername(request.resource.data.username)
        && shortString(request.resource.data.displayName, 40)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId;
      // The username (and uid) can never change.
      allow update: if isUser(userId)
        && request.resource.data.username == resource.data.username
        && request.resource.data.uid == resource.data.uid
        && onlyChanged(['displayName', 'photoUrl', 'photoPublicId'])
        && shortString(request.resource.data.displayName, 40);
      allow delete: if isUser(userId);

      // Owner-only settings (blocked list, muted chats). The Worker reads these with admin creds.
      match /private/{doc} {
        allow read, write: if isUser(userId);
      }
      // FCM device tokens, owner-only.
      match /tokens/{token} {
        allow read, write: if isUser(userId);
      }
    }

    // ---------- Usernames (unique, permanent) ----------
    match /usernames/{name} {
      allow read: if signedIn();
      // Only claimable while creating your profile, so one account = one username, forever.
      allow create: if signedIn()
        && validUsername(name)
        && request.resource.data.uid == uid()
        && !exists(/databases/$(database)/documents/users/$(uid()))
        && getAfter(/databases/$(database)/documents/users/$(uid())).data.username == name;
      allow update: if false;
      // Released only by its owner when they delete their account.
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // ---------- Chats ----------
    function validDmId(chatId, members) {
      return members.size() == 2
        && (chatId == 'dm_' + members[0] + '_' + members[1] || chatId == 'dm_' + members[1] + '_' + members[0]);
    }

    match /chats/{chatId} {
      // A DM id is predictable, so allow checking whether "my" DM exists yet.
      allow get: if signedIn() && (
        (resource == null && chatId.matches('^dm_.*') && uid() in chatId.split('_'))
        || (resource != null && uid() in resource.data.members)
      );
      allow list: if signedIn() && uid() in resource.data.members;

      allow create: if signedIn()
        && uid() in request.resource.data.members
        && request.resource.data.createdBy == uid()
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 50
        && (
          (request.resource.data.type == 'direct' && validDmId(chatId, request.resource.data.members))
          || (request.resource.data.type == 'group' && shortString(request.resource.data.name, 40)
              && request.resource.data.admins == [uid()])
        )
        && request.resource.data.disappearing in ['off', '24h', '7d'];

      allow update: if signedIn() && uid() in resource.data.members
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          // Everyday updates: last message, read receipts, disappearing timer, group name/photo.
          (onlyChanged(['lastMessage', 'lastMessageAt', 'lastRead', 'disappearing', 'name', 'photoUrl'])
            && request.resource.data.members == resource.data.members
            && request.resource.data.disappearing in ['off', '24h', '7d']
            && (resource.data.type == 'group' || !changed().hasAny(['name', 'photoUrl'])))
          // Groups: any member can add people (members only grow).
          || (resource.data.type == 'group'
            && onlyChanged(['members'])
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() <= 50)
          // Groups: you can remove only yourself (leave).
          || (resource.data.type == 'group'
            && onlyChanged(['members', 'lastRead', 'admins'])
            && request.resource.data.members.toSet() == resource.data.members.toSet().difference([uid()].toSet())
            && !(uid() in request.resource.data.get('admins', [])))
        );
      allow delete: if false;

      // ---------- Messages ----------
      match /messages/{messageId} {
        allow read: if isMember(chatId);

        allow create: if isMember(chatId)
          && request.resource.data.senderId == uid()
          && request.resource.data.type in ['text', 'image', 'file', 'voice', 'gif', 'sticker', 'system']
          && shortString(request.resource.data.text, 4000)
          && request.resource.data.reactions.size() == 0
          && request.resource.data.hiddenFor.size() == 0
          && request.resource.data.createdAt == request.time;

        allow update: if isMember(chatId) && (
          // React: only your own key in the reactions map.
          (onlyChanged(['reactions'])
            && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([uid()]))
          // Delete for me: only add yourself to hiddenFor.
          || (onlyChanged(['hiddenFor'])
            && request.resource.data.hiddenFor.toSet().difference(resource.data.hiddenFor.toSet()) == [uid()].toSet()
            && request.resource.data.hiddenFor.hasAll(resource.data.hiddenFor))
        );

        // Unsend = sender deletes for everyone. Any member may sweep expired disappearing messages.
        allow delete: if isMember(chatId) && (
          resource.data.senderId == uid()
          || (resource.data.get('expireAt', null) != null && resource.data.expireAt < request.time)
        );
      }
    }

    // Collection-group query used by "Delete account" (only your own messages).
    match /{path=**}/messages/{messageId} {
      allow list: if signedIn() && resource.data.senderId == uid();
    }

    // ---------- Calls ----------
    match /calls/{callId} {
      allow read: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.callerId == uid()
        && request.resource.data.members == [uid(), request.resource.data.calleeId]
        && request.resource.data.status == 'ringing'
        && request.resource.data.type in ['voice', 'video']
        && isMember(request.resource.data.chatId)
        && request.resource.data.calleeId in chatDoc(request.resource.data.chatId).data.members;
      allow update: if signedIn() && uid() in resource.data.members
        && onlyChanged(['status', 'acceptedAt', 'endedAt'])
        && request.resource.data.status in ['accepted', 'declined', 'ended', 'missed'];
      allow delete: if false;
    }

    // ---------- Sticker packs ----------
    match /stickerPacks/{packId} {
      allow read: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && isMember(request.resource.data.chatId)
        && request.resource.data.members == chatDoc(request.resource.data.chatId).data.members
        && shortString(request.resource.data.name, 30)
        && request.resource.data.stickers.size() == 0;
      allow update: if signedIn() && uid() in resource.data.members
        && onlyChanged(['stickers', 'name'])
        && request.resource.data.stickers.size() <= 120;
      allow delete: if signedIn() && resource.data.createdBy == uid();
    }
  }
}
